# Copy to .env and fill in. NEVER commit .env.
SMARTHEALTH_ENV=production

# Required: 64 random hex chars. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMARTHEALTH_SECRET=

# Database. Compose builds this from the POSTGRES_* values below.
POSTGRES_USER=smarthealth
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=smarthealth
# For a managed database set DATABASE_URL instead (postgres:// URLs are accepted):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated hostnames this app is served on (blocks Host-header spoofing).
SMARTHEALTH_ALLOWED_HOSTS=health.example.org

# Only true when the site is served over HTTPS (it must be in production).
SMARTHEALTH_COOKIE_SECURE=true
# IPs of your reverse proxy allowed to set X-Forwarded-For (needed for correct login throttling).
FORWARDED_ALLOW_IPS=*

SMARTHEALTH_TZ=Asia/Kolkata
SMARTHEALTH_TOKEN_TTL=28800
SMARTHEALTH_LOG_LEVEL=INFO
WEB_CONCURRENCY=1
